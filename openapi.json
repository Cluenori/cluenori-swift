{
  "openapi": "3.1.0",
  "info": {
    "title": "CluenoriIngest",
    "version": "0.0.1"
  },
  "paths": {
    "/ingest/v1/app/batch": {
      "post": {
        "tags": [
          "appIngest"
        ],
        "operationId": "appIngest.sendBatch",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "AppBatchAccepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppBatchAccepted"
                }
              }
            }
          },
          "401": {
            "description": "SdkKeyRejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdkKeyRejected"
                }
              }
            }
          },
          "429": {
            "description": "TooManySignals",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManySignals"
                }
              }
            }
          }
        },
        "description": "Records a batch of an app's signals: sessions, launches, memory, screens, events, and MetricKit's reports, from one installation of one release. A signal sent before, by its ID, is counted once, so a batch may be sent again after a failure. The country is read from the request's address, which isn't kept. 401 for an SDK key the deployment doesn't know or revoked: stop sending. 429 when the key or the installation sent too much lately: keep the batch and send it after `retryAfterSeconds`. 413 for a body over 1 MB: send fewer signals at once. 503 when Cluenori couldn't keep the batch: nothing of it was counted; send it again after `Retry-After`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppBatch"
              }
            }
          },
          "required": true
        }
      }
    },
    "/ingest/v1/app/manifest": {
      "get": {
        "tags": [
          "appManifest"
        ],
        "operationId": "appManifest.manifest",
        "parameters": [
          {
            "name": "environment",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 40
            },
            "required": true
          },
          {
            "name": "release",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "required": true
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 35
            },
            "required": false
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "AppManifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppManifest"
                }
              }
            }
          },
          "401": {
            "description": "SdkKeyRejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdkKeyRejected"
                }
              }
            }
          }
        },
        "description": "The manifest of one release of the SDK key's component: what the app should do about its version (`none`, `recommend` a newer release, or `require` an update), with the release to update to and the project's words in the language asked for. The same for every installation of the release, and cached at the edge for `maxAgeSeconds`. 401 for an SDK key the deployment doesn't know or revoked; an SDK then keeps the last manifest it got, and never blocks without one."
      }
    }
  },
